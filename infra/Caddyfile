# Replace kasauti.example.com with the real domain; Caddy provisions TLS automatically.
kasauti.example.com {
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /admin* {
        reverse_proxy api:8000
    }
    handle /healthz {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy web:3000
    }
}
