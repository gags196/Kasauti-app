# Copy to .env and fill in. Never commit .env.
KASAUTI_ENV=dev
KASAUTI_DATABASE_URL=postgresql+asyncpg://kasauti:kasauti@localhost:5432/kasauti
KASAUTI_REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 (S3-compatible)
KASAUTI_R2_ENDPOINT_URL=
KASAUTI_R2_ACCESS_KEY_ID=
KASAUTI_R2_SECRET_ACCESS_KEY=

# LLM / embeddings
KASAUTI_ANTHROPIC_API_KEY=
KASAUTI_VOYAGE_API_KEY=

# Signs learner session tokens. Must be 32+ bytes, and must be replaced outside dev
# (the API refuses to start in a non-dev env while this default is in place).
KASAUTI_AUTH_SECRET=dev-only-secret-change-in-production-32b
