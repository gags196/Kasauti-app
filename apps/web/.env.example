# Copy to .env.local. The web app only ever talks to the FastAPI backend.
KASAUTI_API_BASE_URL=http://localhost:8000

# Same origin, but reachable by the browser directly: figure <img> tags are fetched
# client-side (including from the exam runner, a client component), so this needs the
# NEXT_PUBLIC_ prefix Next.js inlines into the browser bundle. KASAUTI_API_BASE_URL above
# is not visible there. In dev these are the same URL; in prod point both at the API's
# public address.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to 1 while the database holds seed_demo_questions.py fixtures, so every
# page carries a visible "fabricated demo data" banner. Unset it for real data.
NEXT_PUBLIC_DEMO_DATA=1
